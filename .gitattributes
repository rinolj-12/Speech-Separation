# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF (avoids Windows CRLF ^M bad interpreter error)
*.sh text eol=lf

# Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python, config, and documentation files use LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
